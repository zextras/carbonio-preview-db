if [[ $(id -u) -ne 0 ]]; then
  echo "Please run as root"
  exit 1
fi

if command -v carbonio-preview-db-hcl > /dev/null; then
  carbonio-preview-db-hcl migrate || :
  if ! carbonio-preview-db-hcl render; then
    echo "Cannot render /etc/zextras/service-discover/carbonio-preview-db.hcl; leaving pending-setup to be retried."
    exit 1
  fi
fi

# Decrypt the bootstrap token, asking the password to the sys admin
# --setup check for SETUP_CONSUL_TOKEN env. variable and uses it
# to avoid re-asking for the password multiple times
echo -n "Insert the cluster credential password: "
export CONSUL_HTTP_TOKEN
CONSUL_HTTP_TOKEN=$(service-discover bootstrap-token --setup)
EXIT_CODE="$?"
echo ""
if [[ "${EXIT_CODE}" != "0" ]]; then
  echo "cannot access to bootstrap token"
  exit 1;
fi
# Limit secret visibility as much as possible
export -n SETUP_CONSUL_TOKEN

POLICY_NAME='carbonio-preview-db-policy'
POLICY_DESCRIPTION='Carbonio Preview database service policy for config generation and for sidecar proxy'

# Create or update policy for the specific service (this will be shared across cluster)
if ! consul acl policy create -name "${POLICY_NAME}" -description "${POLICY_DESCRIPTION}" -rules @/etc/carbonio/preview-db/service-discover/policies.json >/dev/null 2>&1; then
    if ! consul acl policy update -no-merge -name "${POLICY_NAME}" -description "${POLICY_DESCRIPTION}" -rules @/etc/carbonio/preview-db/service-discover/policies.json; then
      echo "Setup failed: Cannot update policy for ${POLICY_NAME}"
      exit 1
    fi
fi

# Declare the service as tcp
consul config write /etc/carbonio/preview-db/service-discover/service-protocol.json

# Allow other services to contact this service
consul config write /etc/carbonio/preview-db/service-discover/intentions.json

service-discover service-token ensure --service carbonio-preview-db --policy "${POLICY_NAME}" \
  --token-file /etc/carbonio/preview-db/service-discover/token --owner carbonio-preview-db

consul reload


systemctl restart carbonio-preview-db-sidecar.service

# remove tokens leaked by previous setup runs (needs the bootstrap token)
service-discover service-token prune-legacy --service carbonio-preview-db --policy "${POLICY_NAME}"

# Limit token visibility as much as possible
export -n CONSUL_HTTP_TOKEN
rc=$?
if command -v carbonio-preview-db-hcl > /dev/null; then
  carbonio-preview-db-hcl show || :
fi
exit "${rc}"
